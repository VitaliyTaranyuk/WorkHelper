SPRING_PROFILES_ACTIVE=vds
DB_URL=jdbc:postgresql://HOST:PORT/DB_NAME
POSTGRES_USER=username
POSTGRES_PASSWORD=password
ORIGIN_CORS=https://your-domain.example.com
LOCAL_CORS=

# TD-019: секрет подписи JWT. ОБЯЗАТЕЛЕН — без него приложение не стартует
# (кроме профилей local/test, где генерируется одноразовый).
# Сгенерировать: openssl rand -base64 48
# Смена значения разлогинивает всех пользователей — это ожидаемо.
JWT_SECRET=

# ТП-208: улучшение текста голосового ввода/названия задачи через DeepSeek.
# Пустое значение = функция выключена (безопасный фолбэк).
DEEPSEEK_API_KEY=
