# Шаблон окружения локальной БД для docker-compose.
#
#   cp .env.example .env
#
# Файл .env в git не хранится. Значения придумываете сами — база локальная,
# наружу не смотрит, но её учётные данные всё равно не должны попадать
# в репозиторий (K-33): один и тот же пароль, размноженный по README, шаблонам
# и CI, перестаёт быть локальным.
#
# Те же значения подставьте в backend/src/main/resources/application-local.yml
# (шаблон — application-local.yml.example), иначе backend не подключится.

POSTGRES_DB=
POSTGRES_USER=
POSTGRES_PASSWORD=
