# Контекст сборки — только исходники и описание сборки (TD-023).
# Локальные артефакты в контекст не попадают: они весят десятки мегабайт и,
# что важнее, старый app.jar рядом с Dockerfile больше не должен иметь
# никакого влияния на образ.
build/
.gradle/
app.jar
*.jar
logs/
enviroment/

# T-103 (TD-001): локальный профиль разработчика не попадает в образ даже
# если лежит в рабочей копии. `COPY src ./src` запекал его в КАЖДЫЙ образ,
# включая продовый, — то есть креды ехали в контейнер вместе с кодом.
# Образ берёт конфигурацию из окружения (профили vds/prod), локальный
# файл ему не нужен ни при какой сборке.
src/main/resources/application-local.yml
