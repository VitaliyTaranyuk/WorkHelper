<?xml version="1.0" encoding="UTF-8"?>
<!--
  T-104. Каждое исключение здесь — решение с причиной, а не способ заглушить
  анализатор. Правило: если находку можно дёшево и безопасно починить — она
  чинится, а не исключается. Ниже только те, где починка была бы хуже находки.

  Замер первого прогона (2026-08-03): 244 находки, из них 237 — семейство
  EI_EXPOSE_REP, все ранга 18 (самого низкого). После исключений осталось 4
  реальных, и все они исправлены в коде.
-->
<FindBugsFilter>

    <!--
      EI_EXPOSE_REP / EI_EXPOSE_REP2 — «геттер отдаёт (сеттер принимает) ссылку
      на изменяемый объект». 237 из 244 находок первого прогона.

      Для этого кода это не дефект, а устройство: JPA-сущности изменяемы по
      определению (Hibernate меняет их через сеттеры и dirty checking), а
      Lombok-аксессоры к `LocalDate`, коллекциям и связанным сущностям — норма
      слоя данных. «Починка» означала бы защитное копирование в сущностях, то
      есть поломку самого механизма персистентности.
    -->
    <Match>
        <Bug pattern="EI_EXPOSE_REP,EI_EXPOSE_REP2"/>
    </Match>

    <!--
      URF_UNREAD_FIELD в DTO. Поля DTO читает Jackson при сериализации ответа —
      этого SpotBugs не моделирует и считает поле непрочитанным. Удалять такие
      поля значило бы менять контракт API ради тишины анализатора (W-01).
    -->
    <Match>
        <Package name="~ru\.worktechlab\.work_task\.dto.*"/>
        <Bug pattern="URF_UNREAD_FIELD"/>
    </Match>

    <!--
      DMI_RANDOM_USED_ONLY_ONCE в JwtUtils. Детектор нацелен на `new Random()`,
      засеваемый временем: создать и использовать один раз — значит получить
      предсказуемую последовательность. Здесь `new SecureRandom()`, который
      засевается из системного источника энтропии при каждом создании, поэтому
      разовое использование безопасно. Трогать код генерации секретов и токенов
      ради нити производительности — плохой размен (TD-019 куплен дорого).
    -->
    <Match>
        <Class name="ru.worktechlab.work_task.authorization.jwt.JwtUtils"/>
        <Bug pattern="DMI_RANDOM_USED_ONLY_ONCE"/>
    </Match>

    <!--
      SE_BAD_FIELD: CustomUserDetails реализует Serializable (через UserDetails)
      и держит JPA-сущность User. Аутентификация в проекте stateless (JWT,
      SecurityConfig) — HTTP-сессии нет, объект UserDetails не сериализуется
      никогда. Пометить поле `transient` значило бы получить `null` там, где он
      сейчас гарантированно есть, ради сценария, которого нет.
    -->
    <Match>
        <Class name="ru.worktechlab.work_task.config.CustomUserDetails"/>
        <Bug pattern="SE_BAD_FIELD"/>
    </Match>

</FindBugsFilter>
