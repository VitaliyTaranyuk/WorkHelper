# Шаблон локального профиля (T-103, TD-001).
#
# Скопировать рядом без суффикса .example и подставить свои значения:
#   cp application-local.yml.example application-local.yml
#
# Сам application-local.yml в git НЕ хранится (.gitignore) и НЕ попадает
# в docker-образ (backend/.dockerignore). Причина: раньше он лежал
# в репозитории вместе с логином и паролем боевой БД на VPS, а репозиторий
# публичный — креды знал любой, кто открыл GitHub. Вдобавок `COPY src ./src`
# запекал этот файл в КАЖДЫЙ образ, включая продовый.
#
# ЗНАЧЕНИЯ ЗДЕСЬ НЕ ПОДСТАВЛЕНЫ НАМЕРЕННО. В репозитории не должно быть
# учётных данных ни от какой базы — ни боевой, ни локальной. Подставьте те же
# значения, что задали в backend/enviroment/local/.env для docker-compose.

spring:
  datasource:
    url: jdbc:postgresql://localhost:5432/<ИМЯ_БД>
    username: <ПОЛЬЗОВАТЕЛЬ>
    password: <ПАРОЛЬ>
  jpa:
    show-sql: true
    hibernate:
      ddl-auto: none
  liquibase:
    enabled: true
  cors:
    allowed:
      origins: "http://localhost:3000"
      local: "http://localhost:3000,http://localhost:5173"

server:
  servlet:
    context-path:
  port: 8080

app:
  mail:
    enable: false
