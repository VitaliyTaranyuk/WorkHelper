<?xml version="1.0" encoding="UTF-8"?>
<configuration>

    <conversionRule conversionWord="clr" converterClass="org.springframework.boot.logging.logback.ColorConverter"/>
    <conversionRule conversionWord="wex"
                    converterClass="org.springframework.boot.logging.logback.WhitespaceThrowableProxyConverter"/>
    <conversionRule conversionWord="wEx"
                    converterClass="org.springframework.boot.logging.logback.ExtendedWhitespaceThrowableProxyConverter"/>

    <springProperty name="consolePattern" source="logging.config.console"
                    defaultValue="%clr(%d{HH:mm:ss.SSS}){faint} %clr(%5p) %clr(%X{rid}){faint} %clr(%-40.40logger{39}){cyan} %clr(:){faint} %m%n%wEx"/>
    <springProperty name="filePattern" source="logging.config.file" defaultValue="%d %-5level %X{rid} %logger{0}: %msg%n"/>
    <springProperty name="syslogPattern" source="logging.config.syslog" defaultValue="%msg%n"/>
    <springProperty name="syslogHost" source="logging.syslog.host" defaultValue="localhost"/>
    <springProperty name="fileDir" source="logging.file.dir" defaultValue="./logs"/>

    <appender name="STDOUT" class="ch.qos.logback.core.ConsoleAppender">
        <withJansi>true</withJansi>
        <encoder>
            <pattern>${consolePattern}</pattern>
        </encoder>
    </appender>

    <appender name="FILE" class="ch.qos.logback.core.rolling.RollingFileAppender">
        <file>${fileDir}/wt.log</file>
        <rollingPolicy class="ch.qos.logback.core.rolling.SizeAndTimeBasedRollingPolicy">
            <fileNamePattern>${fileDir}/archived/wt.%d{yyyy-MM-dd}.%i.log.zip</fileNamePattern>
            <maxHistory>50</maxHistory>
            <maxFileSize>50MB</maxFileSize>
            <totalSizeCap>2GB</totalSizeCap>
        </rollingPolicy>
        <encoder>
            <charset>utf-8</charset>
            <Pattern>${filePattern}</Pattern>
        </encoder>
    </appender>

    <!--
      T-301: структурированный лог для боевого окружения. Формат ECS
      (Elastic Common Schema) — встроенный в Spring Boot 3.4+, отдельная
      зависимость не нужна. Строка выглядит так (имена полей вложенные, не
      точечные — проверено StructuredLogFormatTest):
        {"@timestamp":"…","log":{"level":"INFO","logger":"…"},
         "service":{"name":"work-task"},"message":"…",
         "rid":"abc123","uid":"…","method":"POST","path":"…",
         "status":"429","ms":"12","ecs":{"version":"8.11"}}
      Поля MDC (rid, uid, method, path, status, ms) идут отдельными членами
      верхнего уровня — их кладёт RequestLogFilter.

      Зачем: единственный канал логов на VDS — `docker logs`, и текстовая
      строка разбирается только глазами. С JSON вопрос «что было в запросе
      abc123» превращается в
          docker logs workhelper-backend-1 | jq 'select(.rid=="abc123")'
      а «сколько было пятисоток за час» — в фильтр по полю status.
    -->
    <appender name="JSON" class="ch.qos.logback.core.ConsoleAppender">
        <encoder class="org.springframework.boot.logging.logback.StructuredLogEncoder">
            <format>ecs</format>
            <charset>utf-8</charset>
        </encoder>
    </appender>

    <appender name="ASYNC" class="ch.qos.logback.classic.AsyncAppender">
        <queueSize>512</queueSize>
        <appender-ref ref="FILE"/>
    </appender>

    <appender name="SYSLOG" class="ch.qos.logback.classic.net.SyslogAppender">
        <syslogHost>${syslogHost}</syslogHost>
        <facility>AUTH</facility>
        <suffixPattern>${filePattern}</suffixPattern>
    </appender>

    <!--for prod LOG everything at INFO level only in file -->
    <springProfile name="prod">
        <root level="INFO">
            <appender-ref ref="ASYNC"/>
        </root>
        <!--custom logger for SYSLOG -->
        <logger name="SyslogEvent" level="INFO" additivity="false">
            <appender-ref ref="SYSLOG"/>
        </logger>
    </springProfile>

    <!--
      Боевой VDS (SPRING_PROFILES_ACTIVE=vds). Профиль отсутствовал в этом файле,
      из-за чего НИ ОДИН appender не подключался: логи приложения не попадали ни
      в файл, ни в stdout — на проде диагностика была слепой (обнаружено при
      разборе фолбэков DeepSeek, ТП-212). Пишем и в файл, и в stdout: в
      контейнере stdout — стандартный канал (`docker logs`).
    -->
    <!--
      T-301: на боевом окружении остаётся ОДИН канал — stdout в формате ECS.

      Файловый appender отсюда убран намеренно: том под ./logs не смонтирован
      (docker-compose.vds.yml монтирует только вложения), поэтому wt.log жил
      внутри записываемого слоя контейнера — терялся при каждой пересборке,
      никем не читался и при этом резервировал до 2 ГБ (totalSizeCap) на диске
      VDS. Лог, который нельзя прочитать, но который занимает место, — хуже
      отсутствующего.

      Текстовый STDOUT заменён на JSON: разбирать `docker logs` глазами и так
      не выходило, а поля MDC в тексте теряются между пробелами.
    -->
    <springProfile name="vds">
        <root level="INFO">
            <appender-ref ref="JSON"/>
        </root>
    </springProfile>

    <!--for local LOG everything at INFO level, but our code in DEBUG -->
    <springProfile name="local">
        <root level="INFO">
            <appender-ref ref="ASYNC"/>
            <appender-ref ref="STDOUT"/>
        </root>
        <!--our code in DEBUG -->
        <logger name="ru.worktechlab.work_task" level="DEBUG" additivity="false">
            <appender-ref ref="ASYNC"/>
            <appender-ref ref="STDOUT"/>
        </logger>
    </springProfile>
    <springProfile name="test">
        <root level="INFO">
            <appender-ref ref="STDOUT"/>
        </root>
        <logger name="ru.worktechlab.work_task" level="DEBUG" additivity="false">
            <appender-ref ref="STDOUT"/>
        </logger>
    </springProfile>

    <!-- https://logback.qos.ch/manual/configuration.html#shutdownHook and https://jira.qos.ch/browse/LOGBACK-1090 -->
    <shutdownHook class="ch.qos.logback.core.hook.DelayingShutdownHook"/>

    <contextListener class="ch.qos.logback.classic.jul.LevelChangePropagator">
        <resetJUL>true</resetJUL>
    </contextListener>

</configuration>
