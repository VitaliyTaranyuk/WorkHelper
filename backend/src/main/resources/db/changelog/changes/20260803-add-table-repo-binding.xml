<?xml version="1.1" encoding="UTF-8" standalone="no"?>
<databaseChangeLog xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
                   xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                   xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.1.xsd">

    <!-- T-510 (ADR-020): привязка проекта к репозиторию.

         Отдельная таблица, а не колонки в `project`: WorkHelper сам монорепо
         (backend/ + frontend/), и проект может быть связан с несколькими
         репозиториями. Отдельная таблица поддерживает N без переделки и следует
         существующему паттерну «набор, принадлежащий проекту» (task_status,
         sprint — тоже отдельные таблицы с FK на project).

         Строго аддитивно (PHASE5_INVARIANTS §4): существующие проекты живут без
         единой строки здесь (инвариант I-03), и `<rollback>` задан явно — правило
         №2 фазы, потому что цепочка отката иначе упрётся в старые необратимые
         changeSet. -->
    <changeSet id="20260803-add-table-repo-binding" author="claude">
        <preConditions onFail="MARK_RAN">
            <not><tableExists tableName="repo_binding"/></not>
        </preConditions>

        <createTable tableName="repo_binding">
            <column name="id" type="varchar(255)">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="project_id" type="varchar(255)">
                <constraints nullable="false"/>
            </column>
            <column name="provider" type="varchar(32)">
                <constraints nullable="false"/>
            </column>
            <column name="url" type="varchar(512)">
                <constraints nullable="false"/>
            </column>
            <column name="default_branch" type="varchar(255)">
                <constraints nullable="false"/>
            </column>
            <column name="created_at" type="timestamp">
                <constraints nullable="false"/>
            </column>
        </createTable>

        <!-- Удаление проекта мягкое (status=DELETED, TD-010), но каскад оставляем
             на случай физического удаления: привязка без проекта смысла не имеет. -->
        <addForeignKeyConstraint baseTableName="repo_binding" baseColumnNames="project_id"
                                 constraintName="fk_repo_binding_project"
                                 referencedTableName="project" referencedColumnNames="id"
                                 onDelete="CASCADE"/>

        <!-- Один и тот же адрес не привязывается к проекту дважды: повторная
             привязка — ошибка ввода, а не два разных объекта. -->
        <addUniqueConstraint tableName="repo_binding" columnNames="project_id, url"
                             constraintName="uq_repo_binding_project_url"/>

        <rollback>
            <dropTable tableName="repo_binding"/>
        </rollback>
    </changeSet>

</databaseChangeLog>
